{
  "name": "jnm-coaching",
  "version": "2.1.0",
  "description": "JNM Coaching fitness application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "migrate-passwords": "node migrate-passwords.js",
    "generate-vapid": "web-push generate-vapid-keys",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --test tests/*.cjs tests/*.mjs",
    "test:unit": "node --test tests/*.cjs tests/image-archive.mjs tests/local-date.mjs tests/native-platform.mjs tests/iphone-duo.mjs tests/duo-device.mjs tests/viewport-manifest.mjs",
    "test:duo-layout": "node --test tests/iphone-duo-layout.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@neondatabase/serverless": "^1.2.0",
    "@parse/node-apn": "^8.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "4.2.0",
    "terser": "^5.51.2",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8"
  },
  "overrides": {
    "node-forge": "1.4.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
