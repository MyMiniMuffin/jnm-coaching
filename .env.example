# Database Configuration
NETLIFY_DATABASE_URL=postgresql://user:password@host/database

# JWT Secret (Generer en sterk, tilfeldig streng i produksjon)
JWT_SECRET=your-secret-key-here-change-in-production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Push (PWA / nettleser)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:kontakt@perfectmorning.dev
VITE_WEB_PUSH_PUBLIC_KEY=

# Apple Push Notification service (iOS App Store)
# Last ned .p8-nøkkel fra Apple Developer → Keys, lim inn PEM-innholdet her.
APNS_KEY_ID=
APNS_TEAM_ID=55FDY26LN7
APNS_BUNDLE_ID=no.jnmcoaching.app
APNS_PRIVATE_KEY=
# true for App Store / TestFlight; false bare for lokal development-provisioning
APNS_PRODUCTION=true
